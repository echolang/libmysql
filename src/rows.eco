namespace mysql;

#[docs::see: ["mysql::RowView"]]

/**
 * A result read one row at a time, for results too big to hold. While it is open the connection
 * answers `.busy`; reaching the end, `finish()`, or dropping it frees the connection again.
 * `next()` (or `foreach`) hands out each row decoded whole; `step()` with `view()` reads in place.
 *
 * ```echo
 * mysql::Rows $s = guard $db->stream('SELECT name FROM t');
 * foreach ($s as $row) {
 *     echo $row['name'];
 * }
 * ```
 */
public class Rows : contract::iterable<Row>
{
    private Connection $db;
    private tcp::Deadline $by;
    // rows remain in the current result
    private bool $open;
    private Error? $failure;
    private RowView $view;

    internal constructor(Connection $db, Columns $columns, bool $binary, tcp::Deadline $by, bool $open)
    {
        $this->db = $db;
        $this->by = $by;
        $this->open = $open;
        $this->failure = null;
        $this->view = RowView($columns, $binary);
    }

    destructor()
    {
        status<Error> $done = $this->finish();
    }

    /**
     * Read the head of the result the connection was just sent.
     */
    internal static function begin(Connection $db, bool $binary, tcp::Deadline $by) : result<Rows, Error>
    {
        Head $head = guard $db->head($by) else ($e) {
            $db->abandon($e);
            return .error($e);
        }
        match ($head) {
            Head::done($o) => {
                Rows $none = Rows($db, Columns(array<Column>()), $binary, $by, false);
                $db->busy = $o->more();
                return .ok($none);
            },
            Head::rows($c) => {
                Columns $columns = $c;
                $db->busy = true;
                return .ok(Rows($db, $columns, $binary, $by, true));
            },
        }
    }

    public const function columns() : Columns
    {
        return $this->view->columns;
    }

    /**
     * How the last finished result ended: affected rows, warnings and so on.
     */
    public const function outcome() : Outcome
    {
        return $this->db->ending;
    }

    /**
     * Move to the next row of the current result. True when there is one, then readable through
     * `view()`. False at the end.
     */
    public function step() : result<bool, Error>
    {
        // the common case: the next row is already here
        string::view? $got = $this->arrived();
        if ($got == null) {
            string::view? $moved = guard $this->move() else ($e) {
                return .error($e);
            }
            $got = $moved;
        }
        string::view $packet = guard $got else {
            return .ok(false);
        }
        guard $this->view->load($packet) else ($e) {
            $this->stop($e);
            return .error($e);
        }
        return .ok(true);
    }

    /**
     * The row the last `step()` moved to, read in place. Holds until the next move. After the last
     * row, and after a `next()` (which decodes without the view), it has no values.
     */
    public const function view() : const RowView&
    {
        return $this->view;
    }

    /**
     * The next row, decoded whole, or null at the end of the current result.
     */
    public function next() : result<Row?, Error>
    {
        string::view? $got = $this->arrived();
        if ($got == null) {
            string::view? $moved = guard $this->move() else ($e) {
                return .error($e);
            }
            $got = $moved;
        }
        string::view $packet = guard $got else {
            Row? $none = null;
            return .ok($none);
        }
        // decoded in the one walk that finds its values: the view is not laid out for it
        Row $row = guard Row::read($packet, $this->view->columns, $this->view->binary) else ($e) {
            $this->stop($e);
            return .error($e);
        }
        Row? $some = $row;
        return .ok($some);
    }

    /**
     * The next row's packet when it is already here, with the view moved off the last row. Null
     * when `move` has to look.
     */
    internal function arrived() : string::view?
    {
        if (!$this->open) {
            return null;
        }
        $this->view->leave();
        return $this->db->arrived();
    }

    /**
     * The next row's packet, in place until the next move, or null at the end of the current
     * result. The view stands on no row from here until something loads one.
     */
    internal function move() : result<string::view?, Error>
    {
        string::view? $none = null;
        $this->view->leave();
        if (!$this->open) {
            return .ok($none);
        }
        string::view? $got = guard $this->db->packet($this->by) else ($e) {
            $this->stop($e);
            return .error($e);
        }
        if ($got == null) {
            $this->open = false;
            if (!$this->db->ending->more()) {
                $this->db->busy = false;
            }
        }
        return .ok($got);
    }

    /**
     * Step to the next result of a multi-result answer, dropping what is left of this one. True
     * when there is one, false when that was the last.
     */
    public function more() : result<bool, Error>
    {
        // the rest of this result is dropped unread: each packet only found, nothing decoded
        while ($this->open) {
            if ($this->arrived() == null) {
                guard $this->move() else ($e) {
                    return .error($e);
                }
            }
        }
        if (!$this->db->busy || !$this->db->ending->more()) {
            return .ok(false);
        }
        Head $head = guard $this->db->head($this->by) else ($e) {
            $this->stop($e);
            return .error($e);
        }
        match ($head) {
            Head::done($o) => {
                $this->view->reset(Columns(array<Column>()));
                $this->open = false;
                $this->db->busy = $o->more();
            },
            Head::rows($c) => {
                $this->view->reset($c);
                $this->open = true;
            },
        }
        return .ok(true);
    }

    /**
     * Read and drop whatever is left, so the connection is free. Reports the error a `foreach`
     * over these rows could not hand back.
     */
    public function finish() : status<Error>
    {
        while ($this->db->busy && $this->failure == null) {
            bool $another = guard $this->more() else ($e) {
                break;
            }
            if (!$another) {
                break;
            }
        }
        Error? $failed = $this->failure;
        if ($failed != null) {
            Error $e = guard $failed;
            return .error($e);
        }
        return .ok;
    }

    public function iterate() : RowsCursor
    {
        return RowsCursor($this, Row($this->view->columns, $this->view->binary, RowData()));
    }

    /**
     * A failure ends the stream, and the command with it. The rest of the result is not read, so
     * unless the server ended the command with an error packet the connection closes: leftover
     * bytes would otherwise be the next command's answer.
     */
    internal function stop(Error $e) : void
    {
        if ($this->failure == null) {
            $this->failure = $e;
        }
        $this->open = false;
        $this->db->busy = false;
        $this->db->abandon($e);
    }
}

/**
 * What `foreach` walks `Rows` with: one `Row`, loaded with each row in turn. A loop that does not
 * keep its rows allocates nothing for them. A failure stops the loop; `Rows::finish` reports it.
 */
public struct RowsCursor : contract::iterator<Row>
{
    internal Rows $rows;
    internal Row $row;

    /**
     * Load the next row. False at the end, or after a failure `finish` will report.
     */
    public function advance() : bool
    {
        string::view? $got = $this->rows->arrived();
        if ($got == null) {
            result<string::view?, Error> $moved = $this->rows->move();
            if ($moved->failed()) {
                return false;
            }
            $got = $moved->unwrap();
        }
        string::view $packet = guard $got else {
            return false;
        }
        status<Error> $loaded = $this->row->load($packet);
        if ($loaded->failed()) {
            $this->rows->stop($loaded->failure());
            return false;
        }
        return true;
    }

    /**
     * The row `advance` just loaded. Reused across iterations.
     */
    public function current() : Row&
    {
        return $this->row;
    }
}
