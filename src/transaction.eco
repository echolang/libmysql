namespace mysql;

/**
 * An open transaction. `commit()` makes it stick. Dropping it without a commit rolls it back, so a
 * function that leaves early by `guard ... else { return ... }` cannot leave one half done.
 */
public class Transaction
{
    private Connection $db;
    private bool $open;

    internal constructor(Connection $db)
    {
        $this->db = $db;
        $this->open = true;
    }

    destructor()
    {
        if ($this->open) {
            status<Error> $undone = $this->rollback();
        }
    }

    /**
     * Make the work stick. Fails if this transaction is already finished.
     */
    public function commit(by: tcp::Deadline? $by = null) : status<Error>
    {
        if (!$this->open) {
            return .error(.invalid('the transaction is already finished'));
        }
        $this->open = false;
        guard $this->db->exec('COMMIT', by: $by) else ($e) {
            return .error($e);
        }
        return .ok;
    }

    /**
     * Undo the work. Safe to call twice.
     */
    public function rollback(by: tcp::Deadline? $by = null) : status<Error>
    {
        if (!$this->open) {
            return .ok;
        }
        $this->open = false;
        if (!$this->db->alive()) {
            return .error(.closed);
        }
        guard $this->db->exec('ROLLBACK', by: $by) else ($e) {
            return .error($e);
        }
        return .ok;
    }

    /**
     * True until `commit` or `rollback` (or a drop) finishes this transaction.
     */
    public const function open() : bool
    {
        return $this->open;
    }
}
