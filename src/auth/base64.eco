namespace mysql::auth;

/**
 * The 6-bit value of a base64 character, or 255 for one that is not part of the alphabet.
 */
private function sextet(uint8 $c) : uint8
{
    if ($c >= 65 && $c <= 90) {
        return $c - 65;
    }
    if ($c >= 97 && $c <= 122) {
        return $c - 71;
    }
    if ($c >= 48 && $c <= 57) {
        return $c + 4;
    }
    if ($c == 43) {
        return 62;
    }
    if ($c == 47) {
        return 63;
    }
    return 255;
}

/**
 * Standard base64 (with or without padding) to bytes. Whitespace and line breaks are skipped, as
 * they are inside a PEM block. Null on any other character.
 */
internal function unbase64(const string& $text) : string?
{
    string $out = '';
    uint32 $acc = 0;
    uint32 $bits = 0;
    usize $i = 0;
    while ($i < $text->size()) {
        uint8 $c = $text->byte($i);
        $i = $i + 1;
        if ($c == 32 || $c == 10 || $c == 13 || $c == 9) {
            continue;
        }
        if ($c == 61) {
            break;
        }
        uint8 $v = sextet($c);
        if ($v == 255) {
            return null;
        }
        $acc = ($acc << 6) | ($v as uint32);
        $bits = $bits + 6;
        if ($bits >= 8) {
            $bits = $bits - 8;
            $out->push((($acc >> $bits) & 255) as uint8);
        }
    }
    string? $done = $out;
    return $done;
}
