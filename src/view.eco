namespace mysql;

#[docs::groups: ["Reads", "Views"]]

/**
 * The row a stream stands on, read in place. One pass finds where each value starts; each read
 * decodes just that column. A column nobody asks for costs nothing past that pass. Typed reads
 * follow `Value`: null for a NULL and for the wrong type, `isNull` tells those apart. `value` is
 * the read that reports a malformed packet. A position past the last column stops the program,
 * release build included: that is a bug in the code.
 *
 * ```echo
 * usize $id = $rs->columns()->find('id') ?? 0;
 * while (true) {
 *     bool $more = guard $rs->step();
 *     if (!$more) {
 *         break;
 *     }
 *     int64 $n = $rs->view()->int($id) ?? 0;
 * }
 * ```
 */
public struct RowView
{
    internal Columns $columns;
    internal bool $binary;
    // the row, where the connection read it: valid until the stream moves
    internal string::view $packet;
    // where each value starts in the packet, `NULL_AT` for a NULL; sized once per result
    internal array<uint32> $starts;
    // true while the view stands on a row
    internal bool $on;

    internal constructor(Columns $columns, bool $binary)
    {
        $this->columns = $columns;
        $this->binary = $binary;
        $this->packet = string::view(null, 0);
        $this->starts = array<uint32>();
        $this->on = false;
    }

    #[docs::group: "Views"]
    public const function columns() : Columns
    {
        return $this->columns;
    }

    #[docs::group: "Views"]

    /**
     * How many values this row has. Zero before the first step.
     */
    public const function count() : usize
    {
        if (!$this->on) {
            return 0;
        }
        return $this->starts->count();
    }

    #[docs::group: "Reads"]

    /**
     * True when the value at `$at` is SQL NULL.
     */
    public const function isNull(usize $at) : bool
    {
        $this->check($at);
        return $this->starts[$at] == mysql::protocol::NULL_AT;
    }

    #[docs::group: "Reads"]

    /**
     * The value at `$at`, decoded as its column says, NULL included.
     */
    public const function value(usize $at) : result<Value, Error>
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return .ok(Value::none);
        }
        return $c->value($this->columns->at($at));
    }

    #[docs::group: "Reads"]

    /**
     * A signed integer, or an unsigned one that fits.
     */
    public const function int(usize $at) : int64?
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return null;
        }
        return $c->int();
    }

    #[docs::group: "Reads"]

    /**
     * An unsigned integer, or a signed one that is not negative.
     */
    public const function uint(usize $at) : uint64?
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return null;
        }
        return $c->uint();
    }

    #[docs::group: "Reads"]

    /**
     * A float, or any number: an integer, or a decimal parsed (and rounded) to a float.
     */
    public const function float(usize $at) : float64?
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return null;
        }
        return $c->float();
    }

    #[docs::group: "Reads"]

    /**
     * True or false from an integer: zero is false, anything else true.
     */
    public const function bool(usize $at) : bool?
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return null;
        }
        return $c->bool();
    }

    #[docs::group: "Reads"]

    /**
     * Text, a decimal as the server wrote it, or bytes as they are. Copied out of the packet.
     */
    public const function text(usize $at) : string?
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return null;
        }
        string::view $v = guard $c->text() else {
            return null;
        }
        string? $out = string::from($v);
        return $out;
    }

    #[docs::group: "Views"]

    /**
     * Text, a decimal or bytes, in place: no copy, valid until the next `step()`. `text()` is the
     * copy that outlives the row.
     */
    public const function view(usize $at) : string::view?
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return null;
        }
        return $c->text();
    }

    #[docs::group: "Reads"]

    /**
     * Bytes, or text as its bytes.
     */
    public const function bytes(usize $at) : string?
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return null;
        }
        string::view $v = guard $c->bytes() else {
            return null;
        }
        string? $out = string::from($v);
        return $out;
    }

    #[docs::group: "Reads"]
    public const function date(usize $at) : Date?
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return null;
        }
        return $c->date();
    }

    #[docs::group: "Reads"]

    /**
     * A DATETIME or TIMESTAMP, or a DATE at midnight.
     */
    public const function datetime(usize $at) : DateTime?
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return null;
        }
        return $c->datetime();
    }

    #[docs::group: "Reads"]
    public const function time(usize $at) : Time?
    {
        mysql::protocol::Cell $c = guard $this->cell($at) else {
            return null;
        }
        return $c->time();
    }

    #[docs::group: "Views"]

    /**
     * The whole row, a copy that outlives the stream: the same `Row` `Rows::next()` hands out.
     * With no row to stand on it stops the program, release build included.
     */
    public const function row() : result<Row, Error>
    {
        if (!$this->on) {
            die('mysql::RowView stands on no row: row() reads the one the last step() moved to');
        }
        return Row::read($this->packet, $this->columns, $this->binary);
    }

    /**
     * Stand on `$packet`, a row of the current result.
     */
    internal function load(string::view $packet) : status<Error>
    {
        $this->packet = $packet;
        status<Error> $laid = mysql::protocol::layout($this->packet, $this->columns, $this->binary, $this->starts);
        $this->on = !$laid->failed();
        return $laid;
    }

    /**
     * Stand on no row: the bytes of the last one are the connection's again.
     */
    internal function leave() : void
    {
        $this->packet = string::view(null, 0);
        $this->on = false;
    }

    /**
     * The rows that follow belong to another result, with these columns.
     */
    internal function reset(Columns $columns) : void
    {
        $this->columns = $columns;
        $this->packet = string::view(null, 0);
        $this->starts->clear();
        $this->on = false;
    }

    /**
     * How to read the value at `$at`, or null for a NULL.
     */
    private const function cell(usize $at) : mysql::protocol::Cell?
    {
        $this->check($at);
        uint32 $start = $this->starts[$at];
        if ($start == mysql::protocol::NULL_AT) {
            return null;
        }
        mysql::protocol::Cell? $c = mysql::protocol::Cell($this->packet, $start as usize, $this->columns->shapes[$at], $this->columns->widths[$at], $this->binary);
        return $c;
    }

    private const function check(usize $at) : void
    {
        if ($at >= $this->count()) {
            die("mysql::RowView has {$this->count()} columns, not {$at + 1}");
        }
    }
}
