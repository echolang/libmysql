use mysql::auth::{native, cachingSha2, unbase64, Big, PublicKey, publicKey, encrypt};

// a throwaway 2048 bit key made with openssl for these tests; the vectors were computed
// independently in python (hashlib and its big integers)
internal const string PUB = "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAxLRlRKotRLDC9l2AgrNM\nBuNKL9m4L81jgW3p4sbb3asmLDPkYU3Aw1zdmD6FGDLcLTc1Tj2VzqG5GXFUJzcU\nfj00LbBXDnmDGQl0SeyxhRfWCbfYIwySTCaEbzquA7wRhiq3J8wlpPgMNz2WgOXH\nQzP2W2PaMBqkw4b9/XN0Fsppo1MjDbGK/ouPH8Jb1K+rS9DWB47gQqHzwPWea4/5\nNvtqDYyclc1WodImK5Jawoyzedt8OQi29wIRx8CdWvi3rKrsSk6s464F1ahhVAOW\na5zisTghLCSIEilVje7KuB+XF0tQSfk5l45HfA2WQ+Ob3dlmlESYsiBPHdxESxjx\niQIDAQAB\n-----END PUBLIC KEY-----\n";
internal const string RSA_PUB = "-----BEGIN RSA PUBLIC KEY-----\nMIIBCgKCAQEAxLRlRKotRLDC9l2AgrNMBuNKL9m4L81jgW3p4sbb3asmLDPkYU3A\nw1zdmD6FGDLcLTc1Tj2VzqG5GXFUJzcUfj00LbBXDnmDGQl0SeyxhRfWCbfYIwyS\nTCaEbzquA7wRhiq3J8wlpPgMNz2WgOXHQzP2W2PaMBqkw4b9/XN0Fsppo1MjDbGK\n/ouPH8Jb1K+rS9DWB47gQqHzwPWea4/5NvtqDYyclc1WodImK5Jawoyzedt8OQi2\n9wIRx8CdWvi3rKrsSk6s464F1ahhVAOWa5zisTghLCSIEilVje7KuB+XF0tQSfk5\nl45HfA2WQ+Ob3dlmlESYsiBPHdxESxjxiQIDAQAB\n-----END RSA PUBLIC KEY-----\n";

internal function salt() : string
{
    string $s = '';
    foreach (1 ..= 20 as $i) {
        $s->push(byteOf($i));
    }
    return $s;
}

internal function key() : PublicKey
{
    PublicKey $k = guard publicKey(PUB) else ($e) {
        die("pem: {$e}");
    }
    return $k;
}

test native_password_proof
{
    assert(crypto::hex(native('secret', salt())) == 'b32bb3a583e1340c0a1108d58b1be49781ad8c2f');
    assert(native('', salt())->empty());
}

test caching_sha2_fast_proof
{
    assert(crypto::hex(cachingSha2('secret', salt())) == '746ebe205d56a0707acb3e796e834e0dd7b1d61743b26bd5202c7a623230c7c9');
    assert(cachingSha2('', salt())->empty());
}

test base64_decodes_with_line_breaks
{
    string $raw = guard unbase64("aGVs\nbG8gd29y\r\nbGQ=");
    assert($raw == 'hello world');
    assert(unbase64('a*b') == null);
}

test both_pem_shapes_give_the_same_key
{
    PublicKey $spki = key();
    PublicKey $pkcs1 = guard publicKey(RSA_PUB) else ($e) {
        die("pem: {$e}");
    }
    assert($spki->size() == 256);
    assert($spki->n->compare($pkcs1->n) == 0);
    assert($spki->e->compare(Big(small: 65537)) == 0);
    assert(publicKey('nope')->failed());
}

test modexp_matches_python
{
    PublicKey $k = key();
    string $a = '';
    foreach (1 .. 200 as $i) {
        $a->push(byteOf($i));
    }
    Big $c = Big(bytes: $a)->power($k->e, $k->n);
    assert(crypto::hex($c->bytes(256)) == '');
}

test modexp_with_a_full_size_exponent
{
    // the private exponent: 2048 bits of square and multiply exercises every path of the division
    PublicKey $k = key();
    string $a = '';
    foreach (1 .. 200 as $i) {
        $a->push(byteOf($i));
    }
    string $d = guard crypto::unhex('');
    Big $c = Big(bytes: $a)->power(Big(bytes: $d), $k->n);
    assert(crypto::hex($c->bytes(256)) == '');
}

test oaep_matches_python_with_a_fixed_seed
{
    string $seed = '';
    foreach (100 .. 120 as $i) {
        $seed->push(byteOf($i));
    }
    string $message = 'secret';
    $message->push(0);
    string $masked = mysql::auth::xor($message, salt());
    string $c = guard encrypt(key(), $masked, $seed) else ($e) {
        die($e);
    }
    assert(crypto::hex($c) == '');
}

test oaep_refuses_a_message_too_long
{
    string $long = str::repeat('x', 215);
    assert(encrypt(key(), $long)->failed());
}

internal function byteOf(int32 $i) : uint8
{
    return $i as uint8;
}
